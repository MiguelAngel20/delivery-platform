# Used by `npm run build` (Vite production mode). Copy to `.env.production` on the VPS.
# Rebuild assets after changing: npm run build
# Do not commit real secrets.

VITE_APP_NAME=ride

# Reverb (VPS / self-hosted WebSockets)
VITE_BROADCAST_CONNECTION=reverb
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=chisdrive.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Leave empty when using Reverb (legacy Pusher on shared hosting)
# VITE_BROADCAST_CONNECTION=pusher
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_APP_CLUSTER=mt1
# VITE_PUSHER_HOST=
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https
