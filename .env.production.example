# Used by `npm run build` (Vite production mode). Copy to `.env.production` on the VPS.
# Rebuild assets after changing: npm run build
# Do not commit real secrets.

VITE_APP_NAME=ride

# Portal hosts (production). Also set in the server .env (not only Vite):
# PORTALS_BY_HOST=true
# PORTAL_SCHEME=https
# PORTAL_STOREFRONT_HOST=chisdrive.com
# PORTAL_ADMIN_HOST=admin.chisdrive.com
# PORTAL_BUSINESS_HOST=business.chisdrive.com
# PORTAL_DRIVER_HOST=driver.chisdrive.com
#
# Required: keep cookies host-scoped. If SESSION_DOMAIN=.chisdrive.com, an admin
# login on admin.* will also authenticate chisdrive.com and Inertia will hit CORS
# when "Iniciar sesión" redirects to admin.chisdrive.com.
# SESSION_DOMAIN=null

# Reverb (VPS / self-hosted WebSockets)
VITE_BROADCAST_CONNECTION=reverb
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=chisdrive.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Leave empty when using Reverb (legacy Pusher on shared hosting)
# VITE_BROADCAST_CONNECTION=pusher
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_APP_CLUSTER=mt1
# VITE_PUSHER_HOST=
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https
