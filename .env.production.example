# Used by `npm run build` (Vite production mode). Copy to `.env.production` and fill.
# Do not commit real secrets. PUSHER_APP_KEY is public (frontend); secret stays only in server `.env`.

VITE_APP_NAME=ride
VITE_BROADCAST_CONNECTION=pusher
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
