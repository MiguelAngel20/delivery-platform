APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps Platform
# Browser key: restrict by HTTP referrers (Maps JavaScript API + Places API)
GOOGLE_MAPS_API_KEY=
# Optional server-only key: restrict by IP (Distance Matrix API). Never put in Vite.
GOOGLE_MAPS_SERVER_API_KEY=
MAPS_DEFAULT_LATITUDE=16.2514000
MAPS_DEFAULT_LONGITUDE=-92.1342000
MAPS_DEFAULT_ZOOM=14
MAPS_DISTANCE_MODE=route_distance
MAPS_ROUTE_CACHE_TTL=3600
DRIVER_LOCATION_FRESHNESS_MINUTES=15
MAPS_GEOCODE_RATE_LIMIT=30
MAPS_DISTANCE_RATE_LIMIT=30

REVERB_APP_ID=ride-local
REVERB_APP_KEY=ride-local-key
REVERB_APP_SECRET=ride-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Push notifications (FCM). Keep PUSH_ENABLED=false until credentials exist.
PUSH_ENABLED=false
PUSH_DRIVER=null
PUSH_DRIVER_OFFER_TTL=120
PUSH_ORDER_UPDATE_TTL=3600
PUSH_DEFAULT_TTL=86400
PUSH_RATING_PROMPT_DELAY_MINUTES=5
PUSH_DEDUPE_TTL=120

FIREBASE_PROJECT_ID=
# Absolute path to service account JSON (never commit the file)
FIREBASE_CREDENTIALS=
# Or raw JSON string for hosts without a mounted file
FIREBASE_CREDENTIALS_JSON=

# Public web config (safe for VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
