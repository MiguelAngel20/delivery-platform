; Required for customer registration OTP (and other queued mail/notifications).
; Copy to /etc/supervisor/conf.d/chisdrive-queue.conf and run:
;   sudo supervisorctl reread && sudo supervisorctl update && sudo supervisorctl start chisdrive-queue:*
;
; Adjust paths and user for your VPS.

[program:chisdrive-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/delivery-platform/artisan queue:work database --sleep=1 --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/delivery-platform/storage/logs/queue.log
stopwaitsecs=3600
